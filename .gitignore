/target
**/*.rs.bk
*.pdb

# Python bytecode cache (tools/check-stubs is a plain script, no venv/build step)
__pycache__/
*.pyc

# Local Greenlit state
.litci/

# Local live stabilization dashboard
.live-roadmap.pid
.live-roadmap.log

# Ignore markdown scratch/notes files except README and the project's
# required governance docs (AGENTS.md/spec/TESTING.md/PHASE-*.md/ARCHITECTURE.md
# and stabilization ledgers/workflow are mandated to stay tracked).
*.md
!README.md
!AGENTS.md
!greenlit-v0-spec.md
!TESTING.md
!ARCHITECTURE.md
!PHASE-*.md
!docs/STABILIZATION-*.md
!docs/PARITY-EXCEPTIONS.md
!docs/parity/*.md
