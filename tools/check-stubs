#!/usr/bin/env python3
"""Validate Greenlit's stub discipline (see AGENTS.md "Stub discipline").

A stub's body is exactly:

    unimplemented!("STUB(phase-N): <missing behavior>")

Every such marker in source must have exactly one corresponding OPEN row in
AGENTS.md's "Stub registry" table (same location, same owning phase, and an
un-filled "Realized in" column), and that owning phase must be "not started"
in the "Phase status" table. A registry row whose "Realized in" column has
been filled in (closed) must have no matching marker left in source.

This script is intentionally dependency-free (stdlib only) so it runs with
any Python 3 interpreter in CI without an install step.
"""

from __future__ import annotations

import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
AGENTS_MD = REPO_ROOT / "AGENTS.md"
CRATES_DIR = REPO_ROOT / "crates"

# Cell values that mean "no value here" in the registry tables (the
# placeholder dash row, or an outright empty cell).
PLACEHOLDER_CELLS = {"", "-", "--", "—"}

# The exact stub marker: a call to `unimplemented!` whose sole argument is a
# double-quoted string literal starting with "STUB(phase-N): ". Deliberately
# does not accept `format!`-style interpolation — AGENTS.md mandates the
# literal-string form so the message is inspectable by this script without
# running the macro.
STUB_MARKER_RE = re.compile(
    r'unimplemented!\(\s*"STUB\(phase-(?P<phase>\d+)\):\s*(?P<desc>[^"]*)"\s*\)'
)


@dataclass(frozen=True)
class Marker:
    file: str  # repo-relative, forward-slash path
    line: int
    phase: int
    description: str

    @property
    def location(self) -> str:
        return f"{self.file}:{self.line}"


@dataclass(frozen=True)
class RegistryRow:
    location: str
    missing_behavior: str
    owning_phase_raw: str
    realized_in_raw: str
    row_number: int  # 1-based index among data rows, for error messages

    @property
    def is_placeholder(self) -> bool:
        cells = (self.location, self.missing_behavior, self.owning_phase_raw, self.realized_in_raw)
        return all(c.strip() in PLACEHOLDER_CELLS for c in cells)

    @property
    def is_open(self) -> bool:
        return self.realized_in_raw.strip() in PLACEHOLDER_CELLS

    @property
    def owning_phase(self) -> int | None:
        m = re.search(r"\d+", self.owning_phase_raw)
        return int(m.group()) if m else None


@dataclass(frozen=True)
class PhaseStatusRow:
    phase_raw: str
    file_raw: str
    status: str

    @property
    def phase_number(self) -> int | None:
        m = re.search(r"\d+", self.phase_raw)
        return int(m.group()) if m else None


def fail(messages: list[str]) -> None:
    print("check-stubs: FAILED", file=sys.stderr)
    for msg in messages:
        print(f"  - {msg}", file=sys.stderr)
    sys.exit(1)


def list_source_files() -> list[Path]:
    """Every tracked-or-would-be-tracked file under crates/, git-ignore aware.

    Uses `git ls-files` (cached + others-minus-ignored) so build artifacts
    under crates/*/target/ are never scanned, matching "tracked source
    files" without requiring files to already be committed. Falls back to a
    plain filesystem walk (skipping `target` directories) if git is
    unavailable, so the check still runs outside a git checkout.
    """
    if not CRATES_DIR.is_dir():
        return []

    try:
        out = subprocess.run(
            [
                "git",
                "ls-files",
                "--cached",
                "--others",
                "--exclude-standard",
                "--",
                "crates",
            ],
            cwd=REPO_ROOT,
            capture_output=True,
            text=True,
            check=True,
        )
        rel_paths = [line for line in out.stdout.splitlines() if line]
        return [REPO_ROOT / p for p in rel_paths if (REPO_ROOT / p).is_file()]
    except (subprocess.CalledProcessError, FileNotFoundError):
        found = []
        for path in CRATES_DIR.rglob("*"):
            if not path.is_file():
                continue
            if "target" in path.relative_to(CRATES_DIR).parts:
                continue
            found.append(path)
        return found


def scan_markers() -> list[Marker]:
    markers: list[Marker] = []
    for path in sorted(list_source_files()):
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        rel = path.relative_to(REPO_ROOT).as_posix()
        for match in STUB_MARKER_RE.finditer(text):
            line = text.count("\n", 0, match.start()) + 1
            markers.append(
                Marker(
                    file=rel,
                    line=line,
                    phase=int(match.group("phase")),
                    description=match.group("desc").strip(),
                )
            )
    return markers


def split_table_row(line: str) -> list[str]:
    """Split one markdown table row into trimmed cell texts.

    Honors `\\|` as a literal pipe (not a cell delimiter) rather than
    naively `str.split("|")`-ing, and drops the empty leading/trailing
    cells produced by a row's outer `|` delimiters.
    """
    stripped = line.strip()
    if stripped.startswith("|"):
        stripped = stripped[1:]
    if stripped.endswith("|"):
        stripped = stripped[:-1]

    cells: list[str] = []
    current: list[str] = []
    escape = False
    for ch in stripped:
        if escape:
            current.append(ch)
            escape = False
        elif ch == "\\":
            escape = True
        elif ch == "|":
            cells.append("".join(current).strip())
            current = []
        else:
            current.append(ch)
    cells.append("".join(current).strip())
    return cells


SEPARATOR_ROW_RE = re.compile(r"^\s*\|?(\s*:?-+:?\s*\|)+\s*:?-+:?\s*\|?\s*$")


def find_table_rows(markdown: str, heading: str) -> list[list[str]]:
    """Return the data rows (as split cells) of the first table under `heading`.

    `heading` must match a whole markdown heading line exactly (e.g.
    "## Stub registry"). Raises ValueError with a precise complaint if the
    heading or a well-formed table under it cannot be found.
    """
    lines = markdown.splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if line.strip() == heading)
    except StopIteration as exc:
        raise ValueError(f"AGENTS.md: no {heading!r} heading found") from exc

    # Walk forward to the first table row (a line starting with '|'),
    # stopping if we hit the next heading first.
    i = start + 1
    while i < len(lines) and not lines[i].strip().startswith("|"):
        if lines[i].strip().startswith("#"):
            raise ValueError(f"AGENTS.md: no table found under {heading!r} before the next heading")
        i += 1
    if i >= len(lines):
        raise ValueError(f"AGENTS.md: no table found under {heading!r}")

    header = split_table_row(lines[i])
    i += 1
    if i >= len(lines) or not SEPARATOR_ROW_RE.match(lines[i]):
        raise ValueError(f"AGENTS.md: table under {heading!r} is missing its '---' separator row")
    i += 1

    rows: list[list[str]] = []
    while i < len(lines) and lines[i].strip().startswith("|"):
        cells = split_table_row(lines[i])
        if len(cells) != len(header):
            raise ValueError(
                f"AGENTS.md: row {cells!r} under {heading!r} has {len(cells)} cells, "
                f"expected {len(header)} to match header {header!r}"
            )
        rows.append(cells)
        i += 1

    return rows


def load_stub_registry() -> list[RegistryRow]:
    markdown = AGENTS_MD.read_text(encoding="utf-8")
    rows = find_table_rows(markdown, "## Stub registry")
    registry = []
    for n, cells in enumerate(rows, start=1):
        location, missing_behavior, owning_phase, realized_in = cells
        registry.append(RegistryRow(location, missing_behavior, owning_phase, realized_in, n))
    return registry


def load_phase_status() -> list[PhaseStatusRow]:
    markdown = AGENTS_MD.read_text(encoding="utf-8")
    rows = find_table_rows(markdown, "## Phase status")
    return [PhaseStatusRow(phase, file_, status) for phase, file_, status in rows]


def main() -> int:
    try:
        registry = load_stub_registry()
        phase_status = load_phase_status()
    except ValueError as exc:
        fail([str(exc)])
        return 1  # unreachable, fail() exits

    markers = scan_markers()

    real_rows = [row for row in registry if not row.is_placeholder]
    open_rows = {(row.location, row.owning_phase): row for row in real_rows if row.is_open}
    closed_rows = [row for row in real_rows if not row.is_open]

    phase_by_number = {
        row.phase_number: row.status.strip().lower()
        for row in phase_status
        if row.phase_number is not None
    }

    problems: list[str] = []

    marker_locations = {(m.file, m.line) for m in markers}

    def parse_location(loc: str) -> tuple[str, int] | None:
        if "/" not in loc or ":" not in loc:
            return None
        file_part, _, line_part = loc.rpartition(":")
        try:
            return (file_part, int(line_part))
        except ValueError:
            return None

    # Rule: a closed registry row (Realized in filled) must have no
    # remaining marker at its location.
    closed_locations: set[tuple[str, int]] = set()
    for row in closed_rows:
        loc_key = parse_location(row.location)
        if loc_key is not None:
            closed_locations.add(loc_key)
        if loc_key is not None and loc_key in marker_locations:
            problems.append(
                f"registry row #{row.row_number} (location {row.location!r}) has "
                f"'Realized in' = {row.realized_in_raw!r} filled in, but a STUB marker "
                f"still exists at that location — remove the marker, it was implemented"
            )

    # Rule: every marker needs a corresponding OPEN registry row (same
    # location, same owning phase). Skip markers already reported above as
    # sitting at a closed row's location — that diagnosis is more specific
    # and repeating "no open row" for the same spot is just noise.
    for m in markers:
        row = open_rows.get((m.location, m.phase))
        if row is None:
            if (m.file, m.line) in closed_locations:
                continue
            problems.append(
                f"{m.location}: STUB(phase-{m.phase}) marker "
                f"({m.description!r}) has no open row in AGENTS.md's Stub "
                f"registry table — add one with Location = {m.location!r} "
                f"and Owning phase = {m.phase}"
            )
            continue

        # Rule: the owning phase must be "not started".
        status = phase_by_number.get(m.phase)
        if status is None:
            problems.append(
                f"{m.location}: STUB(phase-{m.phase}) names a phase not present in "
                f"AGENTS.md's Phase status table"
            )
        elif status != "not started":
            problems.append(
                f"{m.location}: STUB(phase-{m.phase}) is owned by phase {m.phase}, "
                f"whose status is {status!r} — only markers owned by a 'not started' "
                f"phase are permitted (see AGENTS.md Stub discipline)"
            )

    if problems:
        fail(problems)
        return 1  # unreachable, fail() exits

    print(
        "check-stubs: OK — "
        f"{len(markers)} marker(s) in source, {len(real_rows)} registered stub row(s) "
        f"({len(open_rows)} open, {len(closed_rows)} closed), all consistent"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
