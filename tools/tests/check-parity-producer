#!/usr/bin/env python3
"""Behavior gate for canonical live oracle/GitHub capture production."""

from __future__ import annotations

import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True

from parity_producer_bounds import run_bounds_canaries
from parity_producer_fixture import (
    JOB_ID,
    REPOSITORY_ID,
    RUN_ID,
    github_inputs,
    write_job_log,
)


def main() -> int:
    root = Path(__file__).resolve().parents[2]
    tool = root / "tools" / "collect-parity-observation"
    with tempfile.TemporaryDirectory(prefix="greenlit-parity-producer-test-") as name:
        test_root = Path(name)
        checkout = test_root / "checkout"
        output_root = test_root / "output"
        checkout.mkdir()
        output_root.mkdir(mode=0o700)
        workflow = checkout / ".github/workflows/parity-seed.yml"
        workflow.parent.mkdir(parents=True)
        shutil.copyfile(root / ".github/workflows/parity-seed.yml", workflow)
        _git(checkout, "init", "-q")
        _git(checkout, "config", "user.name", "Parity Producer Test")
        _git(checkout, "config", "user.email", "parity@example.invalid")
        _git(checkout, "add", ".github/workflows/parity-seed.yml")
        _git(checkout, "commit", "-qm", "test: parity source")
        source_commit = _git(checkout, "rev-parse", "HEAD").stdout.strip()

        trusted = [
            "--checkout",
            str(checkout),
            "--repository-id",
            REPOSITORY_ID,
            "--source-commit",
            source_commit,
        ]
        production = [*trusted, "--output-root", str(output_root)]
        _run(_tool_command(tool, "oracle", *production))
        poison = test_root / "bash-environment-poison"
        poison.write_text(f"touch {test_root / 'poison-ran'}\n", encoding="utf-8")
        _run(
            _tool_command(tool, "oracle", *production),
            environment_overrides={
                "BASH_ENV": str(poison),
                "GIT_DIR": str(test_root / "missing-git-directory"),
                "LD_PRELOAD": str(test_root / "missing-preload.so"),
            },
        )
        if (test_root / "poison-ran").exists():
            raise RuntimeError("oracle inherited a forbidden shell execution hook")

        _git(
            checkout,
            "update-index",
            "--skip-worktree",
            ".github/workflows/parity-seed.yml",
        )
        failed = _run(_tool_command(tool, "oracle", *production), success=False)
        if "forbids skip-worktree" not in failed.stderr:
            raise RuntimeError("skip-worktree source concealment was not rejected")
        _git(
            checkout,
            "update-index",
            "--no-skip-worktree",
            ".github/workflows/parity-seed.yml",
        )

        raw = test_root / "raw-api"
        raw.mkdir()
        inputs = github_inputs(raw, workflow.read_bytes(), source_commit)
        github = _tool_command(
            tool,
            "github-actions",
            *production,
            "--run-id",
            str(RUN_ID),
            "--run-json",
            str(inputs["run"]),
            "--jobs-json",
            str(inputs["jobs"]),
            "--content-json",
            str(inputs["content"]),
            "--job-log",
            str(inputs["log"]),
            "--self-test-raw-evidence",
        )
        _run(github)
        failed = _run(github[:-1], success=False)
        if "raw GitHub evidence is restricted" not in failed.stderr:
            raise RuntimeError("canonical GitHub producer accepted raw evidence")
        original_run = inputs["run"].read_bytes()
        inputs["run"].write_text(
            '{"id":' + "9" * 5000 + "}",
            encoding="utf-8",
        )
        failed = _run(github, success=False)
        if "Traceback" in failed.stderr or "missing field" not in failed.stderr:
            raise RuntimeError("unbounded JSON integer escaped fail-closed validation")
        inputs["run"].write_bytes(original_run)
        run_bounds_canaries(
            tool=tool,
            test_root=test_root,
            checkout=checkout,
            output_root=output_root,
            trusted=trusted,
            source_commit=source_commit,
            github_inputs=inputs,
            run_id=RUN_ID,
            job_id=JOB_ID,
        )
        private_paths = [
            (output_root, 0o700),
            (output_root / "captures", 0o700),
            (output_root / "seed-oracle.json", 0o600),
            (output_root / "seed-github-actions.json", 0o600),
            (
                output_root
                / "captures/shell-only-seed-oracle.json",
                0o600,
            ),
            (
                output_root
                / "captures/shell-only-seed-github-actions.json",
                0o600,
            ),
        ]
        for path, expected_mode in private_paths:
            metadata = path.lstat()
            expected_kind = stat.S_ISDIR if expected_mode == 0o700 else stat.S_ISREG
            if (
                not expected_kind(metadata.st_mode)
                or stat.S_IMODE(metadata.st_mode) != expected_mode
                or metadata.st_uid != os.geteuid()
            ):
                raise RuntimeError(f"private output mode drifted for {path}")

        alias_parent = test_root / "alias-parent"
        alias_parent.mkdir()
        internal_output = checkout / ".git/parity-output"
        internal_output.mkdir(mode=0o700)
        lexical_internal = alias_parent / ".." / "checkout/.git/parity-output"
        failed = _run(
            _tool_command(
                tool,
                "oracle",
                *trusted,
                "--output-root",
                str(lexical_internal),
            ),
            success=False,
        )
        if "outside and disjoint" not in failed.stderr:
            raise RuntimeError("lexical parent traversal bypassed output containment")

        unsafe_output = test_root / "unsafe-output"
        unsafe_output.mkdir(mode=0o700)
        escaped = test_root / "escaped-captures"
        escaped.mkdir(mode=0o700)
        (unsafe_output / "captures").symlink_to(
            escaped, target_is_directory=True
        )
        unsafe_production = [
            *trusted,
            "--output-root",
            str(unsafe_output),
        ]
        failed = _run(
            _tool_command(tool, "oracle", *unsafe_production),
            success=False,
        )
        if "captures directory must be a real mode-0700" not in failed.stderr:
            raise RuntimeError(
                "symlinked capture parent was not rejected: " + failed.stderr
            )

        write_job_log(inputs["log"], duplicate=True)
        failed = _run(github, success=False)
        if "duplicate output marker 'seed_value'" not in failed.stderr:
            raise RuntimeError("duplicate marker inside the job log was not rejected")
        write_job_log(inputs["log"], masked=True)
        failed = _run(github, success=False)
        if "did not observe exactly seed_value=greenlit" not in failed.stderr:
            raise RuntimeError("masked runtime marker was reconstructed from command echo")
        write_job_log(inputs["log"])

        original_jobs = inputs["jobs"].read_bytes()
        job_mutations = (
            ("id", JOB_ID + 1),
            ("run_id", RUN_ID + 1),
            ("run_attempt", 2),
            ("head_sha", "f" * 40),
            ("name", "Different job"),
            ("run_url", "https://api.github.com/repos/other/run"),
            ("url", "https://api.github.com/repos/other/job"),
            ("html_url", "https://github.com/other/job"),
        )
        for field, value in job_mutations:
            jobs_document = json.loads(original_jobs)
            jobs_document["jobs"][0][field] = value
            inputs["jobs"].write_text(
                json.dumps(jobs_document, separators=(",", ":")),
                encoding="utf-8",
            )
            failed = _run(github, success=False)
            if "does not bind the requested run attempt" not in failed.stderr:
                raise RuntimeError(f"job-log identity accepted mutated {field}")
        inputs["jobs"].write_bytes(original_jobs)

        retired = _run(
            _tool_command(tool, "verify", *trusted, "--role", "oracle"),
            success=False,
        )
        if "invalid choice: 'verify'" not in retired.stderr:
            raise RuntimeError("historical fixed-capture replay remains routable")

        (checkout / "ancestor-marker").write_text("new HEAD\n", encoding="utf-8")
        _git(checkout, "add", "ancestor-marker")
        _git(checkout, "commit", "-qm", "test: advance parity source")
        failed = _run(_tool_command(tool, "oracle", *production), success=False)
        if "HEAD differs from trusted source commit" not in failed.stderr:
            raise RuntimeError("live producer accepted an ancestor source commit")

    print("parity producer behavior gate passed: exact-HEAD oracle + GitHub")
    return 0


def _git(checkout: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return _run(["git", "-C", str(checkout), *arguments])


def _run(
    command: list[str],
    *,
    success: bool = True,
    environment_overrides: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    environment = {
        key: value
        for key, value in os.environ.items()
        if not key.upper().endswith("_TOKEN")
        and all(
            fragment not in key.upper()
            for fragment in ("SECRET", "PASSWORD", "CREDENTIAL")
        )
    }
    environment.update(environment_overrides or {})
    result = subprocess.run(
        command,
        env=environment,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=120,
        check=False,
    )
    if success and result.returncode != 0:
        raise RuntimeError(
            f"command failed ({result.returncode}): {' '.join(command)}\n{result.stderr}"
        )
    if not success and result.returncode == 0:
        raise RuntimeError(f"command unexpectedly passed: {' '.join(command)}")
    return result


def _tool_command(tool: Path, *arguments: str) -> list[str]:
    """Invoke a Python tool even when a private snapshot strips host modes."""

    return [sys.executable, "-B", str(tool), *arguments]


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"parity producer behavior gate failed: {error}", file=sys.stderr)
        raise SystemExit(1) from error
