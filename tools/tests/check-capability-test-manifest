#!/usr/bin/python3 -I
"""Check or execute exact feature-gated capability test owner groups."""

from __future__ import annotations

import json
import os
import sys
from typing import Any

if not sys.flags.isolated:
    os.execve(
        "/usr/bin/python3",
        ["/usr/bin/python3", "-I", "-B", __file__, *sys.argv[1:]],
        os.environ,
    )
sys.dont_write_bytecode = True
sys.pycache_prefix = "/proc/self/fd/greenlit-impossible-pycache"

from pathlib import Path

_ENTRYPOINT = Path(__file__).absolute()
if _ENTRYPOINT.is_symlink():
    print(
        "capability test manifest gate failed: launcher must not be a symbolic link",
        file=sys.stderr,
    )
    raise SystemExit(1)
sys.path[:0] = [str(_ENTRYPOINT.parent), str(_ENTRYPOINT.parents[1])]

from cargo_test_manifest import (
    CargoTarget,
    GateError,
    cargo_metadata,
    listed_tests,
    run_target,
    unique_object,
    validate_release_profile_environment,
)
from capability_manifest_selftest import self_test_negative
from capability_workflows import validate_route_schema, validate_workflow_routes
from test_authority.model import GateError as AuthorityGateError


ROOT = Path(__file__).resolve().parents[2]
MANIFEST = Path(__file__).with_name("capability-test-manifest.json")
TOP_LEVEL_KEYS = {"schema_version", "targets", "workflow_routes"}
ENTRY_KEYS = {
    "cargo_profile",
    "features",
    "owner",
    "package",
    "target",
    "test_cfgs",
    "tests",
}
CARGO_PROFILES = {"release", "test"}
OWNERS = {
    "credential-keyring",
    "docker-policy",
    "docker-runtime",
    "host-deep-path",
    "stargz-provider",
}
RELEASE_PROFILE_TARGETS = {
    ("greenlit-app", "performance_budgets"),
}
TEST_CFGS = {"litci_test_boundaries"}


def text_list(value: Any, location: str, *, nonempty: bool) -> list[str]:
    """Validate one sorted unique string array."""

    if not isinstance(value, list) or (nonempty and not value):
        qualifier = "nonempty " if nonempty else ""
        raise GateError(f"{location} must be a {qualifier}array")
    result: list[str] = []
    for index, item in enumerate(value):
        if not isinstance(item, str) or not item or item.strip() != item:
            raise GateError(f"{location}[{index}] must be nonempty trimmed text")
        result.append(item)
    if len(result) != len(set(result)):
        raise GateError(f"{location} contains a duplicate")
    if result != sorted(result):
        raise GateError(f"{location} must be sorted")
    return result


def load_manifest(
    path: Path = MANIFEST,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """Load the strict owner-partitioned capability manifest."""

    if path.is_symlink() or not path.is_file():
        raise GateError(f"{path}: manifest must be a regular non-symlink file")
    try:
        value = json.loads(
            path.read_text(encoding="utf-8"),
            object_pairs_hook=unique_object,
        )
    except OSError as error:
        raise GateError(f"could not read {path}: {error}") from error
    except json.JSONDecodeError as error:
        raise GateError(f"{path}: invalid JSON: {error}") from error

    if not isinstance(value, dict) or set(value) != TOP_LEVEL_KEYS:
        raise GateError(
            f"{path}: top level must contain exactly {sorted(TOP_LEVEL_KEYS)!r}"
        )
    if (
        not isinstance(value["schema_version"], int)
        or isinstance(value["schema_version"], bool)
        or value["schema_version"] != 3
    ):
        raise GateError(f"{path}: schema_version must be 3")
    entries = value["targets"]
    if not isinstance(entries, list) or not entries:
        raise GateError(f"{path}: targets must be a nonempty array")

    identities: set[tuple[str, str]] = set()
    previous: tuple[str, str] | None = None
    owners_seen: set[str] = set()
    for index, entry in enumerate(entries):
        location = f"{path}: targets[{index}]"
        if not isinstance(entry, dict) or set(entry) != ENTRY_KEYS:
            raise GateError(f"{location} must contain exactly {sorted(ENTRY_KEYS)!r}")
        for field in ("cargo_profile", "package", "target", "owner"):
            text = entry[field]
            if not isinstance(text, str) or not text or text.strip() != text:
                raise GateError(f"{location}.{field} must be nonempty trimmed text")
        if entry["cargo_profile"] not in CARGO_PROFILES:
            raise GateError(
                f"{location}.cargo_profile must be one of "
                f"{sorted(CARGO_PROFILES)!r}"
            )
        if entry["owner"] not in OWNERS:
            raise GateError(
                f"{location}.owner must be one of {sorted(OWNERS)!r}"
            )
        owners_seen.add(entry["owner"])
        entry["features"] = text_list(
            entry["features"], f"{location}.features", nonempty=True
        )
        entry["test_cfgs"] = text_list(
            entry["test_cfgs"], f"{location}.test_cfgs", nonempty=False
        )
        unknown_cfgs = set(entry["test_cfgs"]) - TEST_CFGS
        if unknown_cfgs:
            raise GateError(
                f"{location}.test_cfgs contains unknown cfgs {sorted(unknown_cfgs)!r}"
            )
        identity = (entry["package"], entry["target"])
        expected_cfgs = (
            ["litci_test_boundaries"]
            if entry["package"] == "greenlit-app"
            and identity not in RELEASE_PROFILE_TARGETS
            else []
        )
        if entry["test_cfgs"] != expected_cfgs:
            raise GateError(
                f"{location}.test_cfgs must be {expected_cfgs!r} for "
                f"{entry['package']}"
            )
        entry["tests"] = text_list(
            entry["tests"], f"{location}.tests", nonempty=True
        )
        if identity in identities:
            raise GateError(f"{location} duplicates target identity {identity!r}")
        if previous is not None and identity < previous:
            raise GateError(f"{path}: targets must be sorted by package and target")
        identities.add(identity)
        previous = identity
    release_targets = {
        (entry["package"], entry["target"])
        for entry in entries
        if entry["cargo_profile"] == "release"
    }
    if release_targets != RELEASE_PROFILE_TARGETS:
        raise GateError(
            f"{path}: release-profile targets differ from the fixed authority; "
            f"missing={sorted(RELEASE_PROFILE_TARGETS - release_targets)!r}, "
            f"unexpected={sorted(release_targets - RELEASE_PROFILE_TARGETS)!r}"
        )
    if owners_seen != OWNERS:
        raise GateError(
            f"{path}: every fixed capability owner must be nonempty; "
            f"missing={sorted(OWNERS - owners_seen)!r}"
        )
    routes = validate_route_schema(value["workflow_routes"], path)
    return entries, routes


def declared_capability_targets(
    targets: list[CargoTarget],
) -> dict[tuple[str, str], tuple[str, ...]]:
    """Extract every required-feature integration target from Cargo."""

    declared: dict[tuple[str, str], tuple[str, ...]] = {}
    for target in targets:
        if "test" not in target.kinds or not target.required_features:
            continue
        identity = (target.package, target.name)
        if identity in declared:
            raise GateError(f"Cargo metadata repeats target {identity!r}")
        declared[identity] = target.required_features
    if not declared:
        raise GateError("Cargo metadata declares no feature-gated capability targets")
    return declared


def validate_declarations(
    entries: list[dict[str, Any]],
    targets: list[CargoTarget],
) -> None:
    """Require a one-to-one manifest/Cargo target mapping."""

    declared = declared_capability_targets(targets)
    manifest = {
        (entry["package"], entry["target"]): tuple(entry["features"])
        for entry in entries
    }
    if manifest == declared:
        return
    manifest_targets = set(manifest)
    declared_targets = set(declared)
    raise GateError(
        "feature-gated test targets differ from the manifest; "
        f"missing={sorted(declared_targets - manifest_targets)!r}, "
        f"unexpected={sorted(manifest_targets - declared_targets)!r}, "
        "feature mismatches="
        f"{sorted(identity for identity in manifest_targets & declared_targets if manifest[identity] != declared[identity])!r}"
    )


def validate_release_feature_markers(
    entries: list[dict[str, Any]],
    targets: list[CargoTarget],
) -> None:
    """Require release authority features to remain dependency-free markers."""

    target_by_identity = {
        (target.package, target.name): target
        for target in targets
    }
    for entry in entries:
        if entry["cargo_profile"] != "release":
            continue
        identity = (entry["package"], entry["target"])
        target = target_by_identity.get(identity)
        if target is None:
            raise GateError(f"release-profile target {identity!r} is absent from Cargo")
        definitions = dict(target.feature_definitions)
        for feature in entry["features"]:
            members = definitions.get(feature)
            if members is None:
                raise GateError(
                    f"{identity!r}: release-profile feature {feature!r} "
                    "is absent from Cargo metadata"
                )
            if members:
                raise GateError(
                    f"{identity!r}: release-profile feature {feature!r} "
                    "must remain an empty Cargo marker"
                )


def validate_cases(entries: list[dict[str, Any]], root: Path) -> int:
    """List and compare every selected target's exact nonzero cases."""

    selected = 0
    for entry in entries:
        actual = listed_tests(
            root,
            package=entry["package"],
            target=entry["target"],
            selector="test",
            features=tuple(entry["features"]),
            test_cfgs=tuple(entry["test_cfgs"]),
            cargo_profile=entry["cargo_profile"],
        )
        expected = entry["tests"]
        if not actual:
            raise GateError(
                f"{entry['package']}/{entry['target']} selected zero tests"
            )
        if actual != expected:
            expected_set = set(expected)
            actual_set = set(actual)
            identity = f"{entry['package']}/{entry['target']}"
            raise GateError(
                f"{identity}: selected tests differ from the manifest; "
                f"missing={sorted(expected_set - actual_set)!r}, "
                f"unexpected={sorted(actual_set - expected_set)!r}"
            )
        selected += len(actual)
    return selected


def run_owner(entries: list[dict[str, Any]], root: Path, owner: str) -> int:
    """Execute every whole target assigned to one fixed capability owner."""

    selected = [entry for entry in entries if entry["owner"] == owner]
    if not selected:
        raise GateError(f"capability owner {owner!r} selects zero targets")
    case_count = validate_cases(selected, root)
    for entry in selected:
        run_target(
            root,
            package=entry["package"],
            target=entry["target"],
            selector="test",
            features=tuple(entry["features"]),
            test_cfgs=tuple(entry["test_cfgs"]),
            cargo_profile=entry["cargo_profile"],
        )
    print(
        f"capability owner {owner} passed: {len(selected)} targets, "
        f"{case_count} tests"
    )
    return 0


def main() -> int:
    """Dispatch the check-only or fixed-owner execution boundary."""

    root = ROOT
    manifest = MANIFEST
    run_group: str | None = None
    if sys.argv[1:] == ["--self-test-negative"]:
        try:
            return self_test_negative()
        except GateError as error:
            print(f"capability test manifest gate failed: {error}", file=sys.stderr)
            return 1
    arguments = sys.argv[1:]
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in {"--run-owner", "--repository-root", "--manifest"}:
            if index + 1 >= len(arguments):
                print(f"{argument} requires a value", file=sys.stderr)
                return 2
            value = arguments[index + 1]
            if argument == "--run-owner":
                run_group = value
            elif argument == "--repository-root":
                root = Path(value).resolve()
            else:
                manifest = Path(value).resolve()
            index += 2
            continue
        print(
            f"usage: {Path(sys.argv[0]).name} "
            "[--run-owner OWNER] [--repository-root PATH] [--manifest PATH] "
            "[--self-test-negative]",
            file=sys.stderr,
        )
        return 2
    if run_group is not None and run_group not in OWNERS:
        print(
            f"unknown capability owner {run_group!r}; "
            f"choose one of {sorted(OWNERS)!r}",
            file=sys.stderr,
        )
        return 2
    if not root.is_dir():
        print(f"repository root is not a directory: {root}", file=sys.stderr)
        return 2

    try:
        entries, routes = load_manifest(manifest)
        selected_entries = (
            entries
            if run_group is None
            else [entry for entry in entries if entry["owner"] == run_group]
        )
        if any(
            entry["cargo_profile"] == "release"
            for entry in selected_entries
        ):
            validate_release_profile_environment()
        route_count, harness_count, source_count = validate_workflow_routes(
            routes, root
        )
        targets = cargo_metadata(root)
        validate_declarations(entries, targets)
        validate_release_feature_markers(entries, targets)
        if run_group is not None:
            return run_owner(entries, root, run_group)
        selected = validate_cases(entries, root)
    except (GateError, AuthorityGateError) as error:
        print(f"capability test manifest gate failed: {error}", file=sys.stderr)
        return 1

    print(
        f"capability test manifest gate passed: {len(entries)} targets, "
        f"{selected} selected tests, {len(OWNERS)} fixed owners, "
        f"{route_count} workflow routes, {harness_count} non-Cargo harnesses, "
        f"{source_count} reviewed sources"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
