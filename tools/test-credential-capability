#!/usr/bin/env bash
# Production persistent-keyring acceptance in an isolated Linux user and
# anonymous session-keyring boundary. Missing prerequisites are failures:
# this gate never substitutes file storage or reports a capability skip.
set -euo pipefail

repository_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
cd "$repository_root"

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "credential capability acceptance requires Linux persistent keyrings" >&2
  exit 1
fi
if ! command -v unshare >/dev/null 2>&1; then
  echo "credential capability acceptance requires the util-linux unshare command" >&2
  exit 1
fi
if ! command -v keyctl >/dev/null 2>&1; then
  echo "credential capability acceptance requires keyctl from the keyutils package" >&2
  exit 1
fi

exec unshare -U --fork \
  keyctl session - \
  tools/tests/check-capability-test-manifest \
    --run-owner credential-keyring
