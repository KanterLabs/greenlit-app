#!/usr/bin/python3 -I
"""Enforce TESTING.md's absolute test-authority bans."""

from __future__ import annotations

import os
import sys

if not sys.flags.isolated:
    os.execve(
        "/usr/bin/python3",
        ["/usr/bin/python3", "-I", "-B", __file__, *sys.argv[1:]],
        os.environ,
    )
sys.dont_write_bytecode = True
sys.pycache_prefix = "/proc/self/fd/greenlit-impossible-pycache"

from pathlib import Path

_ENTRYPOINT = Path(__file__).absolute()
if _ENTRYPOINT.is_symlink():
    print(
        "test authority gate failed: launcher must not be a symbolic link",
        file=sys.stderr,
    )
    raise SystemExit(1)
sys.path[:0] = [str(_ENTRYPOINT.parent)]

from test_authority.gate import check
from test_authority.model import GateError


def repository_root(argument: str | None) -> Path:
    """Resolve one repository root without accepting a non-directory."""

    candidate = (
        Path(argument)
        if argument is not None
        else Path(__file__).resolve().parent.parent
    )
    try:
        resolved = candidate.resolve(strict=True)
    except OSError as error:
        raise GateError(
            f"could not resolve repository root {candidate}: {error}"
        ) from error
    if not resolved.is_dir():
        raise GateError(f"repository root is not a directory: {resolved}")
    return resolved


def main() -> int:
    """Dispatch the check and public negative self-test modes."""

    try:
        if len(sys.argv) == 1:
            return check(repository_root(None))
        if sys.argv[1:] == ["--self-test-negative"]:
            from test_authority.selftest import self_test_negative

            return self_test_negative()
        if len(sys.argv) == 3 and sys.argv[1] == "--repository-root":
            return check(repository_root(sys.argv[2]))
        print(
            f"usage: {Path(sys.argv[0]).name} "
            "[--self-test-negative | --repository-root PATH]",
            file=sys.stderr,
        )
        return 2
    except GateError as error:
        print(f"test authority gate failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
