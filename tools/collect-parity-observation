#!/usr/bin/python3 -I
"""Produce one canonical Phase 12 parity observation from live evidence."""

from __future__ import annotations

import os
import sys

if not sys.flags.isolated:
    os.execve(
        "/usr/bin/python3",
        ["/usr/bin/python3", "-I", "-B", __file__, *sys.argv[1:]],
        os.environ,
    )
sys.dont_write_bytecode = True
sys.pycache_prefix = "/proc/self/fd/greenlit-impossible-pycache"

from pathlib import Path

_ENTRYPOINT = Path(__file__).absolute()
if _ENTRYPOINT.is_symlink():
    print(
        "parity observation not produced: launcher must not be a symbolic link",
        file=sys.stderr,
    )
    raise SystemExit(1)
sys.path[:0] = [str(_ENTRYPOINT.parent)]

from parity_producer.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
