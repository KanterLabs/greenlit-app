#!/usr/bin/env bash
set -euo pipefail

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo test --workspace
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps
cargo build --release -p greenlit-app

find target/package -maxdepth 1 -type f -name 'greenlit-*.crate' -delete 2>/dev/null || true
cargo package --workspace --exclude greenlit-init --no-verify

sha256sum target/release/litci target/package/*.crate > SHA256SUMS
